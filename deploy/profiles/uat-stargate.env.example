# Copy to uat-stargate.env on Stargate, replace REQUIRED values, and chmod 600.
# Stargate is UAT. This profile must never publish a GitHub release.
NAUTGATE_PROJECT_NAME=nautgate-uat
NAUTGATE_CORE_IMAGE=nautgate-staged-core:0.5.1
NAUTGATE_ROUTER_IMAGE=nautrouter:1.0.0
NAUTGATE_POSTGRES_IMAGE=postgres:16

# During the compatibility transition, set this to the existing validated
# external volume. Never allow Compose to create a blank replacement.
NAUTGATE_DB_VOLUME=nautgate-final-20260905t1652
NAUTGATE_BACKUP_VOLUME=nautgate-uat-backups

# Stargate port 8090 belongs to Beszel. UAT services remain loopback-only.
NAUTGATE_CORE_HOST_PORT=18090
NAUTGATE_ROUTER_HOST_PORT=18404

# Stable Tailscale MagicDNS address of LM Studio on the Mac Studio. Core uses
# it for model discovery/settings; NautRouter uses it for confidential inference.
LMSTUDIO_BASE_URL=http://cand0rians-mac-studio.tail138398.ts.net:1238

NAUTGATE_CORE_MEMORY_LIMIT=1024m
NAUTGATE_CORE_CPU_LIMIT=2.0
NAUTGATE_ROUTER_MEMORY_LIMIT=512m
NAUTGATE_ROUTER_CPU_LIMIT=1.0
NAUTGATE_DB_MEMORY_LIMIT=1536m
NAUTGATE_DB_CPU_LIMIT=2.0

POSTGRES_USER=nautgate
POSTGRES_DB=nautgate
POSTGRES_PASSWORD=REQUIRED

# Provider values may remain empty when encrypted credentials already exist in
# the migrated database. Never commit live secrets.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NAUTGATE_MASTER_KEY=
NAUTGATE_INGEST_TOKEN=

