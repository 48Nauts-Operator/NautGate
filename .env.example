# NautGate runtime configuration
# Copy to .env and fill in. .env is gitignored.

# --- Required: database ---
# Local dev (docker compose up -d nautgate-db):
NAUTGATE_DB_URL=postgres://nautgate:nautgate@localhost:5432/nautgate
# Prod (stargate's agents_postgres) — switch via env, not file:
# NAUTGATE_DB_URL=postgres://nautgate:<pw>@stargate.tail138398.ts.net:5432/agents_postgres

# --- Server ---
NAUTGATE_LISTEN_HOST=0.0.0.0
NAUTGATE_LISTEN_PORT=8090
NAUTGATE_LOG_LEVEL=INFO
NAUTGATE_PROFILE=auto

# --- NautRouter sidecar (Day 2+) ---
NAUTROUTER_BASE_URL=http://localhost:8404

# --- Provider keys (Day 2+; forwarded to NautRouter sidecar) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LMSTUDIO_BASE_URL=
